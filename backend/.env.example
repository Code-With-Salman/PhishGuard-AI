# PhishGuard AI - Environment Configuration
# Used by n8n for PostgreSQL connection
# Copy values to setup-database.ps1 if you change them

# PostgreSQL Configuration
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_USER=phishguard
DB_POSTGRESDB_PASSWORD=secure_password_123
DB_POSTGRESDB_DATABASE=phishguard_ai

# n8n Configuration
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin123
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_TUNNEL_URL=http://localhost:5678/

# Credentials (update with your actual API keys)
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: Email SMTP for sending alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=phishguard@yourcompany.com
