{
  "manifest_version": 3,
  "name": "PhishGuard AI",
  "version": "1.0.0",
  "description": "AI-powered phishing detection for Gmail",

  "action": {
    "default_popup": "src/popup.html",
    "default_title": "PhishGuard AI"
  },

  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "report.html"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ],

  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],

  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:5678/*"
  ]
}
